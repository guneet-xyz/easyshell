DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000

# Cache
REDIS_URL=redis://cache.internal:6379/0
CACHE_TTL_SECONDS=300

# Secrets (yes, in a file, in plain text, we know)
JWT_SECRET=c2hlbGxiZWFyZCB3YXMgaGVyZQ==
SESSION_SECRET=dG90YWxseS1yYW5kb20=
API_SIGNING_KEY=a=b=c==
BEARER_TOKEN=pWCB9FtISBilgXOPyWdEcSXLHAEjwebPbDTdF12vDuUKeDTM

# Branding
BRAND_COLOR=#1da1f2
ACCENT_COLOR=#ff00ff
TAGLINE=Say it in 280 characters, or pay 8 dollars for 281
CEO=Melon Usk
