APP_NAME=Chirp
APP_ENV=production
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=https://chirp.dev/?ref=deploy&utm_source=env
LOG_LEVEL=warn
LOG_FORMAT=json

# Database
